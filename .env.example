# OpenAlgo API Key (required)
# Get from: OpenAlgo Web UI → Settings → API Keys
OPENALGO_API_KEY=your_api_key_here

# OpenAlgo Server URL (optional, default: http://127.0.0.1:5000)
# For Docker: use http://host.docker.internal:5000 to reach host machine
# For VPS: use the actual URL of your OpenAlgo instance
OPENALGO_URL=http://host.docker.internal:5000
